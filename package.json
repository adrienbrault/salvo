  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/three": "0.186.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2"
  }
